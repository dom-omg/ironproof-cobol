       IDENTIFICATION DIVISION.
       PROGRAM-ID. LOOP-TIMES.
      *---------------------------------------------------------------
      * PERFORM n TIMES - generate amortization schedule rows
      *---------------------------------------------------------------
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-PRINCIPAL        PIC 9(9)V99  VALUE 100000.00.
       01  WS-ANNUAL-RATE      PIC 9V9999   VALUE 0.0500.
       01  WS-MONTHLY-RATE     PIC 9V999999 VALUE ZEROS.
       01  WS-MONTHLY-PAYMENT  PIC 9(6)V99  VALUE 1887.12.
       01  WS-BALANCE          PIC 9(9)V99  VALUE ZEROS.
       01  WS-INTEREST-PART    PIC 9(6)V99  VALUE ZEROS.
       01  WS-PRINCIPAL-PART   PIC 9(6)V99  VALUE ZEROS.
       01  WS-TOTAL-INTEREST   PIC 9(8)V99  VALUE ZEROS.
       01  WS-TOTAL-PRINCIPAL  PIC 9(8)V99  VALUE ZEROS.
       01  WS-PERIOD           PIC 9(3)     VALUE ZEROS.

       PROCEDURE DIVISION.
       MAIN-PARA.
           COMPUTE WS-MONTHLY-RATE =
               WS-ANNUAL-RATE / 12
           MOVE WS-PRINCIPAL TO WS-BALANCE
           MOVE ZEROS TO WS-PERIOD
           MOVE ZEROS TO WS-TOTAL-INTEREST
           MOVE ZEROS TO WS-TOTAL-PRINCIPAL
           PERFORM CALC-PAYMENT 12 TIMES
           DISPLAY 'STARTING BALANCE:  ' WS-PRINCIPAL
           DISPLAY 'ENDING BALANCE:    ' WS-BALANCE
           DISPLAY 'TOTAL INTEREST:    ' WS-TOTAL-INTEREST
           DISPLAY 'TOTAL PRINCIPAL:   ' WS-TOTAL-PRINCIPAL
           DISPLAY 'PERIODS PROCESSED: ' WS-PERIOD
           STOP RUN.

       CALC-PAYMENT.
           ADD 1 TO WS-PERIOD
           COMPUTE WS-INTEREST-PART =
               WS-BALANCE * WS-MONTHLY-RATE
           COMPUTE WS-PRINCIPAL-PART =
               WS-MONTHLY-PAYMENT - WS-INTEREST-PART
           IF WS-PRINCIPAL-PART > WS-BALANCE
               MOVE WS-BALANCE TO WS-PRINCIPAL-PART
           END-IF
           SUBTRACT WS-PRINCIPAL-PART FROM WS-BALANCE
           ADD WS-INTEREST-PART TO WS-TOTAL-INTEREST
           ADD WS-PRINCIPAL-PART TO WS-TOTAL-PRINCIPAL
           DISPLAY 'PERIOD ' WS-PERIOD
               ' INT: ' WS-INTEREST-PART
               ' PRIN: ' WS-PRINCIPAL-PART
               ' BAL: ' WS-BALANCE.

       IDENTIFICATION DIVISION.
       PROGRAM-ID. GEN-FIN-433.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-PRINCIPAL         PIC 9(8)V99  VALUE 361443.00.
       01  WS-RATE              PIC V9(4)    VALUE 0.0694.
       01  WS-TERM              PIC 9(3)     VALUE 12.
       01  WS-MONTHLY-RATE      PIC V9(6)    VALUE ZEROS.
       01  WS-PAYMENT           PIC 9(6)V99  VALUE ZEROS.
       01  WS-TOTAL-INT         PIC 9(8)V99  VALUE ZEROS.
       01  WS-TOTAL-COST        PIC 9(8)V99  VALUE ZEROS.
       01  WS-DOWN-PCT          PIC V9(4)    VALUE 0.0018.
       01  WS-DOWN-AMT          PIC 9(8)V99  VALUE ZEROS.
       01  WS-LOAN-AMT          PIC 9(8)V99  VALUE ZEROS.
       PROCEDURE DIVISION.
       MAIN-PARA.
           COMPUTE WS-DOWN-AMT = WS-PRINCIPAL * WS-DOWN-PCT
           COMPUTE WS-LOAN-AMT = WS-PRINCIPAL - WS-DOWN-AMT
           COMPUTE WS-MONTHLY-RATE = WS-RATE / 12
           COMPUTE WS-PAYMENT = WS-LOAN-AMT * WS-MONTHLY-RATE
           COMPUTE WS-TOTAL-INT = WS-PAYMENT * WS-TERM - WS-LOAN-AMT
           COMPUTE WS-TOTAL-COST = WS-LOAN-AMT + WS-TOTAL-INT
           STOP RUN.
